<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>HardPoint.Testing</PackageId>
    <Version>0.1.0-preview.8</Version>
    <!-- Package validation compares the assembly version with the baseline. Pinned to the 0.1
         line so the local smoke pack (0.0.0-smoke) validates against the same baseline as a
         release; bump it with the first release of a new line. -->
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <Authors>Andrei</Authors>
    <Description>Playwright, MSTest and Reqnroll test framework: browser and API driver lifecycle, JSON test configuration, ExtentReports integration and scenario hooks.</Description>
    <PackageTags>playwright;mstest;reqnroll;bdd;ui-testing;api-testing;extentreports</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/gromozeka1/playwright-dotnet-mstest-reqnroll</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Consumer-facing API documentation (IntelliSense and nuget.org), and a build-time guard
         that compares this package against the last published version: an incompatible public API
         change fails the same pack that would ship it. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.1.0-preview.2</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExtentReports" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="Reqnroll.MSTest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Lets the unit tests exercise the context options the driver builds without launching a
       browser, and without widening the public surface. -->
  <ItemGroup>
    <InternalsVisibleTo Include="HardPoint.Testing.Tests" />
  </ItemGroup>

</Project>
